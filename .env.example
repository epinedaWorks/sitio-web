# Copia este archivo a .env y llena los valores reales.
# NUNCA subas el .env real a git.

# URL de conexión a tu base de datos Postgres (ej. desde neon.tech)
DATABASE_URL="postgresql://usuario:password@host/dbname?sslmode=require"

# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-con-una-clave-aleatoria"

# URL pública del sitio (cámbiala en producción)
NEXTAUTH_URL="http://localhost:3000"

# --- Correo (Resend) — opcional; si RESEND_API_KEY está vacía no se envían correos ---
RESEND_API_KEY=""
EMAIL_FROM="Comunidad Python Guatemala <no-reply@pythonguatemala.dev>"
TEAM_EMAIL=""
# Copia oculta opcional: archiva todos los correos salientes (separar por coma).
EMAIL_BCC=""
ADMIN_URL="http://localhost:3000/admin/dashboard"
